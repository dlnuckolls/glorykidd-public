@page "/"

<PageTitle>Turley's Place</PageTitle>

<div class="row">
  <div class="col-md-8 col-sm-12">
    <Card TextAlignment="Alignment.Start" Style="border: 0px; padding-top: 75px;">
      <CardBody>
        <CardTitle><i>Singer, Producer, and Vocal Coach</i></CardTitle>
        <CardText>
          <p style="text-align: justify;">The youngest of five, Turley was born in Charleston, West Virginia. His Dad
            was a pipe fitter and his Mother a seamstress and housewife. Although Richard’s life has been filled with
            what others perceive as tragedy, he exudes a positive spirit contagious to all whom cross his path. Woven
            throughout his life story, he demonstrates the ability to direct energy from life challenges into an
            optimistic attitude that continues to drive him forward.</p>
        </CardText>
        <div style="width: 100%; text-align: center;">
          <a href="/bio" class="text-decoration-none">Learn more&nbsp;&nbsp;
            <Icon Name="IconName.MusicNoteList" />
          </a>
        </div>
      </CardBody>
    </Card>
  </div>
  <div class="col-md-4 col-sm-12">
    <Image Src="images/turley-homepage.jpg" style="border-radius: 50px;"></Image>
  </div>
</div>
