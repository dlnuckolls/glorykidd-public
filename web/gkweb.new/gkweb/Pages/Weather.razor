@page "/weather"
@using gkweb.api.types
@inject HttpClient Http

<PageTitle>Weather</PageTitle>

<h1>Weather</h1>

<p>This component demonstrates fetching data from the server.</p>

@if (staff == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th aria-label="Temperature in Celsius">Name</th>
                <th aria-label="Temperature in Farenheit">Summary</th>
                <th>Image</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var member in staff)
            {
                <tr>
                    <td>@member.Id</td>
                    <td>@member.Title</td>
                    <td>@member.Summary</td>
                    <td>@member.ImageUrl</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private Staff[]? staff;

    protected override async Task OnInitializedAsync()
    {
        staff = await Http.GetFromJsonAsync<Staff[]>(requestUri: "http://localhost:5265/getstaff");
    }
}
